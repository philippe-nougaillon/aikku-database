pkgname=aikku
pkgver=0.1.0
pkgrel=1
pkgdesc='Custom SQLite tables manager inspired by Aikku Access'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/aikku "$pkgdir/usr/bin/aikku"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/aikku.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aikku.svg"
  install -Dm644 "$startdir/aikku.desktop" "$pkgdir/usr/share/applications/aikku.desktop"
}
